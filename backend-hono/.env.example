DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
RECOVERY_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
PUBLIC_READ_MODEL_MODE=disabled
PUBLIC_READ_MODEL_NAMESPACE=pbt:development:v1
PUBLIC_READ_MODEL_REDIS_TIMEOUT_MS=250
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
SYNC_DENIAL_CACHE_ENABLED=false
PUBLIC_NEGATIVE_CACHE_ENABLED=false
